// Intentionally unguarded: number, wrapper name, kernel target, arity, types.
// All active calls are ring-3 interfaces. Legacy unsafe slots 1–13 stay reserved.
HACKOS_SYSCALL(0, exit, ExitUserProcess, 1, int)
HACKOS_SYSCALL(14, user_write, user_write, 2, const char*, uint64_t)
HACKOS_SYSCALL(15, input, UserInput, 0)
HACKOS_SYSCALL(16, console, UserConsole, 1, uint64_t)
HACKOS_SYSCALL(17, clock, UserClock, 1, HackosClock*)
HACKOS_SYSCALL(18, process_info, UserProcessInfo, 2, uint64_t, HackosProcessInfo*)
HACKOS_SYSCALL(19, kill, UserKill, 1, uint64_t)
HACKOS_SYSCALL(20, spawn, UserSpawn, 1, const char*)
HACKOS_SYSCALL(21, open, UserOpen, 1, const char*)
HACKOS_SYSCALL(22, read, UserRead, 3, uint64_t, void*, uint64_t)
HACKOS_SYSCALL(23, close, UserClose, 1, uint64_t)
HACKOS_SYSCALL(24, stat, UserStat, 2, const char*, HackosFileInfo*)
HACKOS_SYSCALL(25, readdir, UserReadDir, 3, const char*, uint64_t, HackosFileInfo*)
HACKOS_SYSCALL(26, power, UserPower, 1, uint64_t)
HACKOS_SYSCALL(27, yield, UserYield, 0)
HACKOS_SYSCALL(28, spawn_args, UserSpawnArgs, 3, const char*, uint64_t, const char* const*)
HACKOS_SYSCALL(29, wait, WaitForChild, 3, uint64_t, int64_t*, uint64_t)
